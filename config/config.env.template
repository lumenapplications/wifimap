# WiFi/MAP v5.2 — Configuration Template
# Copy to /etc/wifimap/config.env and fill in your values.
# chmod 600 /etc/wifimap/config.env

WIFIMAP_LABEL=pi-node-1
WIFIMAP_INTERFACE=wlan0
WIFIMAP_WS_PORT=8765
WIFIMAP_WEB_PORT=8080
WIFIMAP_NOTIFY_PORT=8766

# Auth: SHA-256 of "username:password"
# Generate: python3 -c "import hashlib; print(hashlib.sha256(b'admin:PASS').hexdigest())"
WIFIMAP_AUTH_USER=admin
WIFIMAP_AUTH_HASH=

# Pi-hole (leave blank to disable)
WIFIMAP_PIHOLE_HOST=
WIFIMAP_PIHOLE_TOKEN=

# Ntfy push notifications
WIFIMAP_NTFY_HOST=
WIFIMAP_NTFY_PORT=7777
WIFIMAP_NTFY_TOPIC=wifimap-alerts

# Network (auto-detected if blank)
WIFIMAP_SUBNET=

# Sprint 2: persistence paths
WIFIMAP_DB_PATH=/var/lib/wifimap/wifimap.db
WIFIMAP_ZONES_PATH=/var/lib/wifimap/zones.json
