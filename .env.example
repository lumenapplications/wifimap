# WiFi/MAP v5.3 — Docker environment variables
# Copy this file to .env and fill in your values
# docker-compose will load it automatically

# Ports exposed on the host
DASHBOARD_PORT=8080       # Open in browser
SCANNER_PORT=8766         # Pi scanners connect here (set WIFIMAP_UPSTREAM on each Pi)
AGG_DASHBOARD_PORT=8767   # Dashboard WebSocket connection to aggregation server
NOTIFY_PORT=8768          # HTTP bridge for browser → Ntfy

# Ntfy push notifications
NTFY_HOST=localhost       # Ntfy server hostname or IP
NTFY_PORT=7777            # Ntfy server port
NTFY_TOPIC=wifimap-alerts # Ntfy topic to subscribe to

# Dashboard URL for Ntfy action buttons (leave blank to omit)
# Set to your Tailscale IP so action buttons work from anywhere
DASHBOARD_URL=
