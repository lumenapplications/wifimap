# WiFi/MAP Dashboard — Docker image
# Serves the single-file dashboard via nginx on port 8080.
# The scanner itself runs on the Pi via systemd (needs WiFi hardware).
# This image is for the central MSP dashboard deployment.
#
# Build:
#   docker build -f Dockerfile.dashboard -t wifimap-dashboard .
#
# Run standalone:
#   docker run -p 8080:8080 wifimap-dashboard
#
# Run via docker-compose (recommended):
#   docker-compose up

FROM nginx:alpine

LABEL org.opencontainers.image.title="WiFi/MAP Dashboard"
LABEL org.opencontainers.image.version="5.3"
LABEL org.opencontainers.image.description="WiFi/MAP security monitoring dashboard"

# Copy dashboard
COPY web/index.html /usr/share/nginx/html/index.html

# nginx config — serves on 8080, sets security headers including CSP
RUN cat > /etc/nginx/conf.d/default.conf <<'NGINX'
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' ws: wss:; img-src 'self' data:;" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(js|css|png|ico|woff2)$ {
        expires 1d;
        add_header Cache-Control "public, immutable";
    }

    # Health check endpoint
    location /health {
        return 200 '{"status":"ok","service":"wifimap-dashboard","version":"5.3"}';
        add_header Content-Type application/json;
    }
}
NGINX

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q --spider http://localhost:8080/health || exit 1
